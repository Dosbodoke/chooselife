{
  "name": "chooselife-mobile",
  "main": "expo-router/entry",
  "version": "1.9.5",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-backdrop"
        ]
      }
    }
  },
  "scripts": {
    "dev": "APP_VARIANT=development expo start -c",
    "dev:web": "APP_VARIANT=development expo start -c --web",
    "dev:android": "APP_VARIANT=development expo start -c --android",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "APP_VARIANT=development expo start -c --web",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "format:translations": "eslint --fix --format node_modules/eslint-plugin-i18n-json/formatter.js ./i18n/locales",
    "postinstall": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:test:ota": "APP_VARIANT=development EXPO_PUBLIC_TEST_OTA=true expo start",
    "dev:test:store": "APP_VARIANT=development EXPO_PUBLIC_TEST_STORE=true expo start",
    "maestro": "maestro test .maestro/",
    "maestro:ota": "maestro test .maestro/updates/ota-update-prompt.yaml && maestro test .maestro/updates/ota-update-now.yaml && maestro test .maestro/updates/ota-remind-later.yaml",
    "maestro:store": "maestro test .maestro/updates/store-update-required.yaml",
    "maestro:studio": "maestro studio",
    "dev:preview": "APP_VARIANT=preview expo start -c",
    "update:development": "APP_VARIANT=development eas update --channel development --environment development",
    "update:preview": "APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production": "APP_VARIANT=production eas update --channel production --environment production"
  },
  "dependencies": {
    "@chooselife/ui": "workspace:*",
    "@config-plugins/react-native-blob-util": "14.0.2",
    "@config-plugins/react-native-pdf": "14.0.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/ui": "58.0.21",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@hookform/resolvers": "^3.9.0",
    "@legendapp/list": "^3.3.11",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/tooltip": "~1.0.5",
    "@rn-primitives/types": "^1.5.2",
    "@rnmapbox/maps": "10.3.5",
    "@sentry/react-native": "^8.28.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/query-async-storage-persister": "^5.66.0",
    "@tanstack/react-query": "^5.48.0",
    "@tanstack/react-query-persist-client": "^5.66.0",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "expo": "58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.17",
    "expo-auth-session": "~58.0.13",
    "expo-backdrop": "0.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "^58.0.14",
    "expo-device": "~58.0.5",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "^58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "^0.9.0",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.18",
    "expo-navigation-bar": "~58.0.4",
