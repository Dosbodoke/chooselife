    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-updates": "~58.0.17",
    "geojson": "^0.5.0",
    "i18next": "^24.2.2",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react-native": "^0.378.0",
    "patch-package": "^8.0.0",
    "posthog-react-native": "4.81.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.52.1",
    "react-i18next": "^15.4.0",
    "react-native": "0.88.0",
    "react-native-blob-util": "0.24.9",
    "react-native-clusterer": "^5.0.2",
    "react-native-fast-squircle": "^1.1.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-map-link": "^3.13.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "~4.7.1",
    "react-native-remark": "^1.0.5",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "3.0.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-qr-code": "^2.0.18",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.2.4",
    "type-fest": "^5.2.0",
    "uniwind": "^1.6.3",
    "uuid": "^13.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "jest": "~30.5.2",
    "jest-expo": "^58.0.11",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.15.0"
  }
}
