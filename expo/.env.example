EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
EXPO_PUBLIC_WEB_URL=https://chooselife.club
EXPO_PUBLIC_R2_PUBLIC_URL=https://cdn.chooselife.club

EXPO_PUBLIC_MAPBOX_PUBLIC_KEY=pk.
MAPBOX_DOWNLOAD_TOKEN=sk.
SENTRY_AUTH_TOKEN=sntrys_

# Optional product analytics. Use a free PostHog project without a payment card.
# Without a project key, analytics and experiments are disabled.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local QA only: control or illustrated. Development never sends analytics.
EXPO_PUBLIC_DEV_MAP_VARIANT=
EXPO_PUBLIC_DEV_GROWTH_DEBUG=false

# Build identity and icon. pnpm dev/ios/android select development explicitly.
# Direct Expo commands default to production unless this is set.
# APP_VARIANT=development
# Optional environment-specific Firebase configuration file override.
# GOOGLE_SERVICES_JSON=./credentials/google-services-development.json
