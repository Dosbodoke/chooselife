{
  "cli": {
    "version": ">=24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "node": "24.18.0",
      "pnpm": "11.10.0",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "node": "24.18.0",
      "pnpm": "11.10.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "node": "24.18.0",
      "pnpm": "11.10.0",
      "android": {
        "gradleCommand": ":app:bundleRelease --max-workers=1 --no-parallel"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
